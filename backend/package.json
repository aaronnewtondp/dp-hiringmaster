    "db:reset": "psql $DATABASE_URL -f src/db/schema.sql && psql $DATABASE_URL -f src/db/seed.sql",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@sparticuz/chromium": "143.0.4",
    "@vercel/queue": "^0.11.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-validator": "^7.1.0",
    "google-auth-library": "^11.3.2",
    "googleapis": "^189.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.5.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pdfmake": "^0.2.23",
    "pg": "^8.23.1",
    "puppeteer-core": "24.32.0",
    "xlsx": "^0.18.5"
