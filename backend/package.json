{
  "name": "dp-hms-backend",
  "version": "1.0.0",
  "description": "DigitalPaani Hiring Management System — Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
