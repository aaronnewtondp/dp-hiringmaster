{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/((?!api/portfolio-worker).*)",
      "destination": "/api/index.ts"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdf-parse/dist/pdf-parse/cjs/pdf.worker.mjs"
    },
    "api/portfolio-worker.ts": {
      "maxDuration": 300,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**",
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "portfolio-analysis",
          "retryAfterSeconds": 120
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/email-digest",
      "schedule": "15 8 * * *"
    }
  ]
}
